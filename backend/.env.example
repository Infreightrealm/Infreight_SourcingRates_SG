# ============================================================
# INFREIGHT OCEAN FREIGHT AUTOMATION ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and update values as needed.
# ============================================================

# Mock mode - set to "true" for local offline testing without live carrier web portals
USE_MOCK_CARRIERS=false

# Frontend CORS Allowed Origin
FRONTEND_URL=http://localhost:3000

# Database Connection String
# If DATABASE_URL is omitted, the backend defaults to local SQLite (infreight.db)
DATABASE_URL=postgresql://user:password@localhost:5432/infreight

# ============================================================
# CARRIER PORTAL CREDENTIALS
# Add carrier portal account logins below
# ============================================================

# Maersk Line
MAERSK_USERNAME=your_maersk_username
MAERSK_PASSWORD=your_maersk_password

# Ocean Network Express (ONE)
ONE_USERNAME=your_one_username
ONE_PASSWORD=your_one_password

# CMA CGM Line
CMA_CGM_USERNAME=your_cma_username
CMA_CGM_PASSWORD=your_cma_password

# Hapag-Lloyd Regional Accounts
HAPAG_LLOYD_USERNAME_ROW=your_hapag_row_username
HAPAG_LLOYD_PASSWORD_ROW=your_hapag_row_password
HAPAG_LLOYD_USERNAME_US_CA=your_hapag_us_ca_username
HAPAG_LLOYD_PASSWORD_US_CA=your_hapag_us_ca_password
HAPAG_LLOYD_USERNAME_EU=your_hapag_eu_username
HAPAG_LLOYD_PASSWORD_EU=your_hapag_eu_password

# OOCL Line
OOCL_USERNAME=your_oocl_username
OOCL_PASSWORD=your_oocl_password

# MSC (Mediterranean Shipping Company)
MSC_USERNAME=your_msc_username
MSC_PASSWORD=your_msc_password

# Evergreen Line (Optional)
EVERGREEN_USERNAME=
EVERGREEN_PASSWORD=

# COSCO Shipping (Optional)
COSCO_USERNAME=
COSCO_PASSWORD=

# ============================================================
# PROXY & WEBCRAWLER CONFIGURATION
# ============================================================

# Bright Data Web Unlocker API Key (Optional proxy acceleration)
BRIGHTDATA_API_KEY=your_brightdata_api_key
BRIGHTDATA_ZONE=cma_cgm_unlocker

# Maximum parallel carrier crawling concurrency
CARRIER_MAX_CONCURRENCY=3
