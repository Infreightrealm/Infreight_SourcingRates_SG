# Database
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/infreight

# Mock mode - set to "true" for local testing without real carrier portals
USE_MOCK_CARRIERS=false

# Frontend CORS origin
FRONTEND_URL=http://localhost:3000

# ============================================================
# CARRIER CREDENTIALS
# WARNING: Never commit real values. Use Railway env vars only.
# ============================================================
MAERSK_USERNAME=
MAERSK_PASSWORD=
ONE_USERNAME=
ONE_PASSWORD=
CMA_CGM_USERNAME=
CMA_CGM_PASSWORD=
HAPAG_LLOYD_USERNAME=
HAPAG_LLOYD_PASSWORD=
HAPAG_LLOYD_USERNAME_US_CA=
HAPAG_LLOYD_PASSWORD_US_CA=
HAPAG_LLOYD_USERNAME_EU=
HAPAG_LLOYD_PASSWORD_EU=
HAPAG_LLOYD_USERNAME_ROW=
HAPAG_LLOYD_PASSWORD_ROW=
MSC_USERNAME=
MSC_PASSWORD=
EVERGREEN_USERNAME=
EVERGREEN_PASSWORD=
COSCO_USERNAME=
COSCO_PASSWORD=
OOCL_USERNAME=
OOCL_PASSWORD=
HMM_USERNAME=
HMM_PASSWORD=

# Concurrency limits for parallel carrier searches (prevents CPU/RAM exhaustion)
CARRIER_MAX_CONCURRENCY=2

# ============================================================
# LLM / AI AGENT CONFIG
# ============================================================
GEMINI_API_KEY=
RFQ_AGENT_MOCK=false

# ============================================================
# MONITORING & ALERTS (all optional — leave blank to disable)
# ============================================================
# Sentry error tracking. Get the DSN from Sentry -> Project -> Settings -> Client Keys.
SENTRY_DSN=
SENTRY_ENVIRONMENT=laptop-backend
SENTRY_TRACES_SAMPLE_RATE=0.1

# Healthchecks.io heartbeat ("is the laptop backend alive?").
# Create a check at https://healthchecks.io and paste its ping URL here.
HEALTHCHECK_URL=
HEARTBEAT_INTERVAL=60

# Telegram live warnings. Create a bot via @BotFather for the token,
# and get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


